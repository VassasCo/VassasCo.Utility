<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <RootNamespace>VassasCo.Utility.ConfigHelper</RootNamespace>
    <AssemblyName>VassasCo.Utility.ConfigHelper</AssemblyName>

    <PackageId>VassasCo.Utility.ConfigHelper</PackageId>
    <Version>2.1.0</Version>
    <Authors>VassasCo</Authors>
    <Description>
      零代码实体类与 JSON/XML 配置文件双向映射工具（全自定义读写，读写严格一致）。
      特性：零代码映射、JSON/XML 双格式、注释写入、热重载、原子保存、列表/字典展开、
      属性别名(Alias)、非侵入式 Fluent 映射、事件监听、自定义转换器。
    </Description>
    <PackageTags>config;json;xml;configuration;hot-reload;jsonc</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vassasco/VassasCo.Utility</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vassasco/VassasCo.Utility</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>VassasCoIcon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- net472 / netstandard2.0 的 BCL 不含 System.Text.Json，需显式引用；
       net6+ 内置于运行时，无需引用。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.4" />
  </ItemGroup>

  <!-- 让任意机器（含未安装 VS / 目标包的 CI）都能构建 net472：
       PrivateAssets=all 确保该包不会作为依赖传递给使用方。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\build\IsExternalInit.cs" Link="IsExternalInit.cs" Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="VassasCoIcon.png" Pack="True" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="True" PackagePath="\" />
  </ItemGroup>

</Project>
