<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net6.0;net8.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>VassasCo.Utility</RootNamespace>
    <AssemblyName>VassasCo.Utility.CrashDumpHelper</AssemblyName>

    <PackageId>VassasCo.Utility.CrashDumpHelper</PackageId>
    <Version>2.2.0</Version>
    <Authors>VassasCo</Authors>
    <Description>
      崩溃捕获工具 — 记录崩溃前 FirstChance 异常链 + 生成 Windows MiniDump 文件。
      特性：FirstChance 异常追踪（O(1) 环形缓冲）、崩溃日志、Windows MiniDump 生成、
      可配置输出目录与保留天数、初始化重入保护、可注销监听、内置可选跟踪日志、零外部依赖。
    </Description>
    <PackageTags>crash;dump;minidump;exception;debugging;diagnostics</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://gitee.com/vassasco/VassasCo.Utility</PackageProjectUrl>
    <RepositoryUrl>https://gitee.com/vassasco/VassasCo.Utility</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>VassasCoIcon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- 让任意机器（含未安装 VS / 目标包的 CI）都能构建 net472：
       PrivateAssets=all 确保该包不会作为依赖传递给使用方。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 刻意保持零依赖：曾经为了「写崩溃日志前 flush 队列」这一个动作引入过 LogHelper 项目引用，
       代价是 NuGet 自动生成传递依赖、多项目并存时会重复安装同一份日志库。
       现在由库内的 CrashDumpTrace 承担该职责，本包不再带任何外部依赖。 -->

  <ItemGroup>
    <None Include="README.md" Pack="True" PackagePath="\" />
    <None Include="VassasCoIcon.png" Pack="True" PackagePath="\" />
  </ItemGroup>

</Project>
