<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0436</NoWarn>
    <RootNamespace>VassasCo.Utility</RootNamespace>
    <AssemblyName>VassasCo.Utility.EventBus</AssemblyName>

    <PackageId>VassasCo.Utility.EventBus</PackageId>
    <Version>2.0.0</Version>
    <Authors>VassasCo</Authors>
    <Description>
      轻量级进程内事件总线 — 类型安全的事件发布/订阅，零外部依赖。
      特性：特性自动注册、优先级排序、多通道隔离、条件过滤、粘性事件、异步处理、
      异常隔离、线程封送(SynchronizationContext)、弱引用订阅(防内存泄漏)、订阅快照诊断。
      支持 .NET Framework 4.7.2 / .NET Standard 2.0 / .NET 6 / 8 / 9 / 10。
    </Description>
    <PackageTags>eventbus;pubsub;event;messaging;decoupled;weakreference</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://gitee.com/vassasco/VassasCo.Utility</PackageProjectUrl>
    <RepositoryUrl>https://gitee.com/vassasco/VassasCo.Utility</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>VassasCoIcon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- 让任意机器（含未安装 VS / 目标包的 CI）都能构建 net472：
       PrivateAssets=all 确保该包不会作为依赖传递给使用方。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- net472 / netstandard2.0 的 BCL 不含 IsExternalInit，需自行补充（本库用到 init 访问器） -->
  <ItemGroup>
    <Compile Include="..\..\build\IsExternalInit.cs" Link="IsExternalInit.cs" Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VassasCo.Utility.EventBus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="True" PackagePath="\" />
    <None Include="VassasCoIcon.png" Pack="True" PackagePath="\" />
  </ItemGroup>

</Project>
